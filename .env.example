# --- MUST HAVE: database (Neon, PlanetScale Postgres, or compatible Postgres) ---
# Vercel + Neon supplies both variables automatically.
# Pooled runtime connection used by the application.
DATABASE_URL=
# Direct migration/DDL connection. PlanetScale uses this name.
DATABASE_URL_DIRECT=
# Neon supplies this name automatically through its Vercel integration.
DATABASE_URL_UNPOOLED=
# Optional for manual Vercel setups with a DDL-capable migration URL. The Neon
# Deploy Button path is detected automatically and does not need this setting.
AUTO_MIGRATE=

# --- MUST HAVE: core authentication ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional on Vercel: the deployment hostname is detected automatically.
BETTER_AUTH_URL=http://localhost:3000
# On an empty database, this exact normalized address is the only identity
# allowed to create the first account. That account is atomically made admin.
ADMIN_BOOTSTRAP_EMAIL=

# Email/password sign-up and sign-in work without an email provider. Accounts
# remain unverified and forgotten-password recovery is unavailable until one of
# the optional delivery methods below is configured.

# --- OPTIONAL: verification and password recovery through Resend ---
# Both values are required to enable Resend delivery. The Vercel Marketplace
# integration supplies RESEND_API_KEY. AUTH_EMAIL_FROM must use a domain
# verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="AgentPlan <auth@example.com>"

# Alternative to Resend: configure both webhook values. The endpoint receives
# POST JSON { kind, to, name, url, from } and must return 2xx. If Resend and the
# webhook are both configured, Resend takes precedence.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=

# --- OPTIONAL: additional sign-in through GitHub OAuth ---
# Both values are required to show GitHub sign-in alongside email/password.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OPTIONAL: public app URL (auto-detected on Vercel) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MUST HAVE: private storage ---
# Auto-detected when Vercel Blob is connected. Otherwise defaults to R2.
# Options: vercel-blob, r2, or fs (development only).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage

# Private Vercel Blob. Vercel sets these when a private store is connected;
# modern projects can use BLOB_STORE_ID with Vercel's short-lived OIDC token.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Cloudflare R2 alternative (private bucket, S3-compatible API).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agentplan

# --- MUST HAVE: scheduled cleanup authorization ---
# Authorizes the daily purge cron (/api/cron/purge). Vercel sends it
# automatically when the env var is set. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- OPTIONAL: free-plan limit overrides ---
# Defaults live in lib/limits/plans.ts:
# AP_MAX_DRAFTS_PER_USER, AP_MAX_VERSIONS_PER_DRAFT,
# AP_MAX_IMAGE_VERSIONS_PER_DRAFT, AP_MAX_VIDEO_VERSIONS_PER_DRAFT,
# AP_MAX_STORAGE_BYTES_PER_USER,
# AP_MAX_ACTIVE_TOKENS_PER_USER, AP_UPLOADS_PER_10MIN, AP_UPLOADS_PER_DAY,
# AP_PASSWORD_ATTEMPTS_PER_15MIN, AP_DELETED_RETENTION_DAYS,
# AP_TOKEN_MUTATIONS_PER_HOUR, AP_TOKEN_MUTATIONS_PER_DAY,
# AP_RETIRED_TOKEN_RETENTION_DAYS, AP_AUDIT_RETENTION_DAYS
