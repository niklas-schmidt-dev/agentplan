{
  "name": "agentplan-cli",
  "version": "0.2.0",
  "description": "CLI for agentplan.app — publish HTML, images, and video behind stable links.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-schmidt-dev/agentplan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://agentplan.app",
  "bugs": {
    "url": "https://github.com/niklas-schmidt-dev/agentplan/issues"
  },
  "type": "module",
  "bin": {
